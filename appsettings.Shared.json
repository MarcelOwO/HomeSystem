{
  "Jwt": {
    "Key": "your-secret-key-min-32-chars-long",
    "Issuer": "homesystem.auth",
    "Audience": "homesystem.client",
    "ExpiryMinutes": 60
  },
  "ConnectionStrings": {
    "AuthDB": "Host=authdb;Database=homesystem;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}",
    "UserDB": "Host=userdb;Database=homesystem;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
  }
}